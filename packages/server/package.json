{
  "name": "mcp-page-bridge",
  "version": "0.1.3",
  "type": "module",
  "description": "MCP bridge that aggregates live browser-page MCP servers and exposes them to a coding agent over stdio",
  "license": "MIT",
  "author": "Eray Ates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rytsh/mcp-page-bridge.git"
  },
  "keywords": ["mcp", "model-context-protocol", "browser", "websocket", "agent", "opencode"],
  "bin": {
    "mcp-page-bridge": "./dist/cli.js"
  },
  "exports": {
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@mcp-page-bridge/protocol": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "zod": "^3.25.0"
  }
}
