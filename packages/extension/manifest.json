{
  "manifest_version": 3,
  "name": "mcp-page-bridge",
  "version": "0.1.5",
  "description": "Expose a live browser page's MCP tools to a coding agent via the mcp-page-bridge bridge.",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "tabs", "activeTab", "storage", "alarms", "downloads"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "ws://127.0.0.1/*",
    "ws://localhost/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "mcp-page-bridge",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
