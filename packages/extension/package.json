{
  "name": "@mcp-page-bridge/extension",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "mcp-page-bridge browser extension (MV3): exposes a page's MCP server to the agent via the bridge",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "exports": {
    "./embedded-server": "./src/embedded-server.ts"
  },
  "dependencies": {
    "@mcp-page-bridge/protocol": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "mcp-page-bridge": "workspace:*",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
