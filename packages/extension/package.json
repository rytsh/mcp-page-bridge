{
  "name": "@mcp-page-bridge/extension",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "mcp-page-bridge browser extension (MV3): exposes a page's MCP server to the agent via the bridge",
  "scripts": {
    "build": "node build.mjs",
    "build:firefox": "node build.mjs --firefox",
    "dev": "node build.mjs --watch",
    "dev:firefox": "node build.mjs --firefox --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "exports": {
    "./embedded-server": "./src/embedded-server.ts"
  },
  "dependencies": {
    "mcp-page-bridge-protocol": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
